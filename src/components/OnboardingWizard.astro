<dialog id="onboarding-dialog" class="onboarding-dialog" aria-labelledby="onboarding-title">
  <div class="onboarding-shell">
    <div class="onboarding-topline">
      <span id="onboarding-counter">Step 1 of 4</span>
      <span>Komadrona Review</span>
    </div>

    <div class="onboarding-progress" aria-hidden="true">
      <span id="onboarding-progress-bar"></span>
    </div>

    <section class="onboarding-step" data-onboarding-step="0">
      <span class="eyebrow">Welcome</span>
      <h2 id="onboarding-title">A midwifery review app built around structure and traceable sources.</h2>
      <p>
        Komadrona Review keeps lessons, questions, rationales, bookmarks, attempts, and progress inside one
        application. It is designed to become usable offline after the PWA delivery milestone is complete.
      </p>
      <div class="onboarding-fact">
        <strong>Created by Kirch Ivan A. Balite</strong>
        <span>
          Kirch is the developer and maintainer. He is independently studying the midwifery domain so the system and
          content structure are built with subject understanding, without presenting himself as a midwife, student
          midwife, or clinical reviewer.
        </span>
      </div>
    </section>

    <section class="onboarding-step" data-onboarding-step="1" hidden>
      <span class="eyebrow">Educational boundary</span>
      <h2>Use it for review, not as clinical authority.</h2>
      <p>Komadrona Review is an independent educational project. It is not:</p>
      <ul>
        <li>an official PRC reviewer or guaranteed examination predictor;</li>
        <li>a replacement for formal instruction or supervised training;</li>
        <li>a clinical protocol, treatment guide, or substitute for current institutional guidance; or</li>
        <li>affiliated with or endorsed by PRC, DOH, CHED, any school, or any review center.</li>
      </ul>
      <p><a href="/disclaimer">Read the complete disclaimer</a></p>
    </section>

    <section class="onboarding-step" data-onboarding-step="2" hidden>
      <span class="eyebrow">Local data warning</span>
      <h2>Your learning records remain in this browser.</h2>
      <p>
        Komadrona has no learner-account server backup. Progress, selected answers, quiz attempts, scores, and
        bookmarks are designed to remain on this device in browser storage.
      </p>
      <p>Those records may be permanently removed when you:</p>
      <ul>
        <li>clear site data or browser storage;</li>
        <li>use private browsing;</li>
        <li>remove or reinstall the browser or installed app;</li>
        <li>reset the device; or</li>
        <li>change browsers or devices.</li>
      </ul>
      <p>Export and import are required before the project can describe local progress as recoverable.</p>
    </section>

    <section class="onboarding-step" data-onboarding-step="3" hidden>
      <span class="eyebrow">Confirmation</span>
      <h2>Continue with the correct expectations.</h2>
      <p>
        Practice questions are original learning exercises. No passing result, completeness claim, exact future
        question, or clinical outcome is guaranteed.
      </p>
      <label class="checkbox-row" for="onboarding-acknowledgment">
        <input id="onboarding-acknowledgment" type="checkbox" />
        <span>
          I understand the educational limits and that clearing browser data may permanently delete my local learning
          records.
        </span>
      </label>
    </section>

    <div class="onboarding-actions">
      <button id="onboarding-back" class="button button-secondary" type="button" hidden>Back</button>
      <div class="onboarding-actions-group">
        <button id="onboarding-next" class="button button-primary" type="button">Continue</button>
        <button id="onboarding-finish" class="button button-primary" type="button" hidden disabled>
          Enter Komadrona
        </button>
      </div>
    </div>
  </div>
</dialog>

<noscript>
  <section class="section">
    <div class="container notice">
      <strong>JavaScript is required for onboarding and local practice</strong>
      <p>Read the <a href="/disclaimer">disclaimer</a> and <a href="/privacy">privacy notice</a> before continuing.</p>
    </div>
  </section>
</noscript>

<script>
  const onboardingKey = 'komadrona:v1:onboarding-complete';
  const acknowledgmentKey = 'komadrona:v1:notice-acknowledged';

  const dialog = document.querySelector('#onboarding-dialog');
  const openButton = document.querySelector('#open-onboarding');
  const counter = document.querySelector('#onboarding-counter');
  const progressBar = document.querySelector('#onboarding-progress-bar');
  const backButton = document.querySelector('#onboarding-back');
  const nextButton = document.querySelector('#onboarding-next');
  const finishButton = document.querySelector('#onboarding-finish');
  const acknowledgment = document.querySelector('#onboarding-acknowledgment');
  const steps = Array.from(document.querySelectorAll<HTMLElement>('[data-onboarding-step]'));

  if (
    dialog instanceof HTMLDialogElement &&
    counter instanceof HTMLElement &&
    progressBar instanceof HTMLElement &&
    backButton instanceof HTMLButtonElement &&
    nextButton instanceof HTMLButtonElement &&
    finishButton instanceof HTMLButtonElement &&
    acknowledgment instanceof HTMLInputElement &&
    steps.length > 0
  ) {
    let currentStep = 0;
    let onboardingRequired = true;

    try {
      onboardingRequired = localStorage.getItem(onboardingKey) !== 'true';
    } catch {
      onboardingRequired = true;
    }

    acknowledgment.checked = !onboardingRequired;

    const showStep = (index: number) => {
      currentStep = Math.min(Math.max(index, 0), steps.length - 1);

      steps.forEach((step, stepIndex) => {
        step.hidden = stepIndex !== currentStep;
      });

      counter.textContent = `Step ${currentStep + 1} of ${steps.length}`;
      progressBar.style.width = `${((currentStep + 1) / steps.length) * 100}%`;
      backButton.hidden = currentStep === 0;
      nextButton.hidden = currentStep === steps.length - 1;
      finishButton.hidden = currentStep !== steps.length - 1;
      finishButton.disabled = !acknowledgment.checked;
    };

    const openWizard = () => {
      showStep(0);
      if (!dialog.open) dialog.showModal();
    };

    if (openButton instanceof HTMLButtonElement) {
      openButton.addEventListener('click', openWizard);
    }

    backButton.addEventListener('click', () => showStep(currentStep - 1));
    nextButton.addEventListener('click', () => showStep(currentStep + 1));
    acknowledgment.addEventListener('change', () => {
      finishButton.disabled = !acknowledgment.checked;
    });

    dialog.addEventListener('cancel', (event) => {
      if (onboardingRequired) event.preventDefault();
    });

    finishButton.addEventListener('click', () => {
      if (!acknowledgment.checked) return;

      try {
        localStorage.setItem(onboardingKey, 'true');
        localStorage.setItem(acknowledgmentKey, 'true');
      } catch {
        // The session may continue even when browser settings prevent persistence.
      }

      onboardingRequired = false;
      dialog.close();
      window.location.assign('/app');
    });

    showStep(0);
    if (onboardingRequired) dialog.showModal();
  }
</script>
