---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Offline-first review application</span>
        <h1>Study through a clear path, practice inside the app, and keep progress on your device.</h1>
        <p>
          Komadrona Review organizes Philippine midwifery subjects into mapped modules, source-backed lessons, in-app
          practice, and local progress. No account or external quiz provider is required.
        </p>

        <div class="action-row">
          <a class="button button-primary" href="/app">Open learner home</a>
          <button id="open-onboarding" class="button button-secondary" type="button">Review startup notice</button>
        </div>

        <div class="badge-row" aria-label="Application characteristics">
          <span class="badge">No account required</span>
          <span class="badge">On-device progress</span>
          <span class="badge">In-app practice</span>
          <span class="badge">Source-traceable content</span>
        </div>
      </div>

      <aside aria-labelledby="entry-path-title">
        <span class="eyebrow">Study sequence</span>
        <h2 id="entry-path-title">A straightforward starting path</h2>
        <ol class="entry-sequence">
          <li>
            <div>
              <strong>Open learner home</strong>
              <span>Continue a saved session or choose a new study task.</span>
            </div>
          </li>
          <li>
            <div>
              <strong>Choose a review domain</strong>
              <span>Start from the five mapped examination subjects.</span>
            </div>
          </li>
          <li>
            <div>
              <strong>Practice inside Komadrona</strong>
              <span>Checked answers and session position are saved locally for resume.</span>
            </div>
          </li>
          <li>
            <div>
              <strong>Review local progress</strong>
              <span>Completed attempts, bookmarks, and lesson records stay in this browser.</span>
            </div>
          </li>
        </ol>
      </aside>
    </div>
  </section>

  <section class="section section-muted" aria-labelledby="before-study">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">Before studying</span>
        <h2 id="before-study">Four facts that should remain clear.</h2>
      </div>

      <ul class="plain-facts">
        <li>
          <strong>Independent educational project</strong>
          <span>Not produced, approved, or endorsed by PRC, DOH, CHED, a school, or a review center.</span>
        </li>
        <li>
          <strong>Not clinical instruction</strong>
          <span>It does not replace formal teaching, supervised training, current protocols, or qualified judgment.</span>
        </li>
        <li>
          <strong>Original practice only</strong>
          <span>No leaked, recalled, copied, or confidential licensure questions are permitted.</span>
        </li>
        <li>
          <strong>Browser-local records</strong>
          <span>Clearing site data or changing browsers or devices may permanently remove progress and attempts.</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="current-build-state">
    <div class="container hero-grid">
      <div class="section-heading">
        <span class="eyebrow">Current build state</span>
        <h2 id="current-build-state">The learner workflow and content map exist. Clinical reviewer content is still gated.</h2>
        <p>
          The current branch contains resumable local practice, a learner dashboard, IndexedDB storage, a complete
          module plan for the available official scope, and build-time validation. Public midwifery lessons remain at
          zero until required source packets and review gates are complete.
        </p>
      </div>

      <div>
        <div class="action-row" style="margin-top: 0;">
          <a class="button button-primary" href="/content-map">Inspect content map</a>
          <a class="button button-secondary" href="/content-status">Inspect implementation status</a>
        </div>
        <p class="small-print" style="margin-top: 1rem;">
          Created and maintained by Kirch Ivan A. Balite, a developer independently studying the midwifery domain to
          structure the project responsibly.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
