---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/blueprint.css';
import { blueprintSource, examBlueprint, highestPriorityAreas } from '../data/examBlueprint';
import { assertBlueprintIntegrity } from '../data/blueprintValidation';

assertBlueprintIntegrity(examBlueprint);

const totalVerifiedAreas = examBlueprint.reduce(
  (total, domain) =>
    total + domain.areas.filter((area) => area.evidenceStatus !== 'Partial transcription').length,
  0
);
---

<BaseLayout
  title="Examination Blueprint"
  description="A transparent study-priority map based on the official PRC Midwifery Table of Specifications and current examination program."
>
  <header class="page-header">
    <div class="container">
      <span class="eyebrow">Official-weight study map</span>
      <h1>See which midwifery areas carry the strongest official emphasis.</h1>
      <p>
        This blueprint converts the currently published PRC Table of Specifications into a practical study-priority
        map. It shows official percentage weights and competencies without claiming to predict exact future questions.
      </p>

      <div class="blueprint-summary" aria-label="Blueprint summary">
        <div class="blueprint-stat">
          <strong>5</strong>
          <span>Principal review subjects</span>
        </div>
        <div class="blueprint-stat">
          <strong>{totalVerifiedAreas}</strong>
          <span>Verified weighted areas</span>
        </div>
        <div class="blueprint-stat">
          <strong>2013</strong>
          <span>PRC Table of Specifications year</span>
        </div>
      </div>
    </div>
  </header>

  <section class="section" style="padding-top: 1rem;">
    <div class="container">
      <div class="notice">
        <strong>Weights guide priority; they do not guarantee questions</strong>
        <p>
          A high percentage means the area received substantial emphasis in the official Table of Specifications. It
          does not guarantee that a particular subtopic or question will appear in a future examination. The Board may
          revise its specifications, and current laws and clinical guidance may update the content underneath an older
          competency label.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-muted" aria-labelledby="highest-priority">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">First content releases</span>
        <h2 id="highest-priority">The strongest initial priorities</h2>
        <p>
          These areas have the highest explicit weight in their respective subjects. They will receive the earliest and
          deepest article, source, and practice-question coverage.
        </p>
      </div>

      <div class="priority-grid">
        {highestPriorityAreas.map((area) => (
          <article class="priority-card">
            <div class="blueprint-area-topline">
              <div>
                <span class="badge">{area.domain}</span>
                <h3 style="margin-top: 0.8rem;">{area.label}</h3>
              </div>
              <strong class="weight-number">{area.weightPercent}%</strong>
            </div>
            <p>{area.competencies.slice(0, 2).join(' · ')}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="full-blueprint">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">Subject-by-subject map</span>
        <h2 id="full-blueprint">Official weights and competency clusters</h2>
        <p>
          The percentages below are relative weights within each subject table. The topic labels are either exact
          official headings or clearly marked normalized labels derived from the listed competencies.
        </p>
      </div>

      <div class="blueprint-domain-list">
        {examBlueprint.map((domain) => (
          <article class="blueprint-domain" id={domain.id}>
            <header class="blueprint-domain-header">
              <div>
                <span class="eyebrow" style="margin-bottom: 0.65rem;">{domain.sourceSubjectLabel}</span>
                <h2>{domain.title}</h2>
                {domain.notes && <p>{domain.notes}</p>}
              </div>
              <div class="coverage-meter">
                <strong>{domain.transcriptionCoveragePercent}%</strong>
                <span>exactly transcribed</span>
              </div>
            </header>

            <div class="blueprint-area-list">
              {domain.areas.map((area) => (
                <section class="blueprint-area">
                  <div class="blueprint-area-topline">
                    <div>
                      <h3>{area.label}</h3>
                      {area.officialLabel && (
                        <p class="small-print">Official heading: {area.officialLabel}</p>
                      )}
                      <div class="blueprint-area-meta">
                        <span class="badge">{area.evidenceStatus}</span>
                        <span class="badge">Priority: {area.releasePriority}</span>
                        {area.itemCount && <span class="badge">{area.itemCount} items</span>}
                      </div>
                    </div>
                    <strong class="weight-number">{area.weightPercent}%</strong>
                  </div>

                  <div class="weight-track" aria-hidden="true">
                    <div class="weight-fill" style={`width: ${area.weightPercent}%`}></div>
                  </div>

                  <ul>
                    {area.competencies.map((competency) => <li>{competency}</li>)}
                  </ul>

                  {area.notes && <p class="blueprint-area-note">{area.notes}</p>}
                </section>
              ))}
            </div>

            <footer style="padding: 0 1.4rem 1.4rem;">
              <h3>Planned first-release topics</h3>
              <div class="badge-row" style="margin-top: 0.75rem;">
                {domain.firstReleaseTopics.map((topic) => <span class="badge">{topic}</span>)}
              </div>
            </footer>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-muted" aria-labelledby="source-control">
    <div class="container hero-grid">
      <div class="section-heading">
        <span class="eyebrow">Source control</span>
        <h2 id="source-control">Why this blueprint is defensible</h2>
        <p>
          The 2013 resolution states that the tables specify competencies, percentage weights, item counts, and
          difficulty levels. PRC continues to link this resolution from its current Midwifery board page as of the
          verification date.
        </p>
        <p>
          Komadrona Review combines those weights with the current examination-program subject names and current laws,
          DOH materials, CHED standards, and WHO guidance. The old table prioritizes the study map; newer sources govern
          current facts and recommendations.
        </p>
      </div>

      <article class="card">
        <span class="badge">Core official source</span>
        <h3 style="margin-top: 1rem;">{blueprintSource.title}</h3>
        <p>{blueprintSource.issuer}</p>
        <p>{blueprintSource.use}</p>
        <p class="small-print">Limitation: {blueprintSource.limitation}</p>
        <div class="action-row">
          <a
            class="button button-primary"
            href={blueprintSource.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            Open official TOS PDF
          </a>
          <a
            class="button button-secondary"
            href={blueprintSource.boardPageUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Open PRC Midwifery page
          </a>
        </div>
      </article>
    </div>
  </section>

  <section class="section" aria-labelledby="next-build">
    <div class="container prose" style="padding-bottom: 0;">
      <span class="eyebrow">Next build stage</span>
      <h2 id="next-build">From weights to actual reviewer modules</h2>
      <p>
        The blueprint establishes what to build first. The next code milestone is the topic-content schema, followed by
        the first source-checked module: prenatal assessment and health teaching. Article writing will begin only after
        exact topic sources and required metadata are attached.
      </p>
      <a class="button button-primary" href="/review">Return to review domains</a>
    </div>
  </section>
</BaseLayout>
